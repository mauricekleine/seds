{
  "name": "seds",
  "version": "1.0.0",
  "description": "The official website for SEDS (sedsngo.org)",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "npm run build:css && remix build",
    "build:css": "tailwindcss -m -i ./app.css -o app/app.css",
    "dev": "concurrently \"npm run dev:css\" \"remix dev\"",
    "dev:css": "tailwindcss -w -i ./app.css -o app/app.css",
    "lint": "eslint ./app && prettier ./app --check",
    "lint:fix": "eslint ./app --fix && prettier ./app --write",
    "prepare": "husky install",
    "start": "remix-serve build",
    "typecheck": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauricekleine/seds.git"
  },
  "author": "Maurice Kleine <hey@mauricekleine.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mauricekleine/seds/issues"
  },
  "homepage": "https://sedsngo.org",
  "dependencies": {
    "@mailchimp/mailchimp_transactional": "~1.4.1",
    "@remix-run/node": "~1.19.3",
    "@remix-run/react": "~1.19.3",
    "@remix-run/vercel": "~1.19.3",
    "@tailwindcss/typography": "~0.5.20",
    "@vercel/node": "~2.15.10",
    "classnames": "~2.5.1",
    "contentful": "~9.3.7",
    "dotenv": "~16.6.1",
    "phosphor-react": "~1.4.1",
    "react": "~18.3.1",
    "react-compare-image": "~3.5.23",
    "react-dom": "~18.3.1",
    "tailwindcss": "~3.4.19",
    "yup": "~0.32.11"
  },
  "devDependencies": {
    "@remix-run/dev": "~1.19.3",
    "@remix-run/eslint-config": "~1.19.3",
    "@remix-run/serve": "~1.19.3",
    "@tailwindcss/forms": "~0.5.11",
    "@types/node": "~18.19.130",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "concurrently": "~7.6.0",
    "eslint": "~8.57.1",
    "eslint-config-prettier": "~8.10.2",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-unused-imports": "~2.0.0",
    "husky": "~8.0.3",
    "lint-staged": "~13.3.0",
    "prettier": "~2.8.8",
    "typescript": "~4.9.5",
    "taze": "21.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.34.7"
}
