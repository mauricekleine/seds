{
  "name": "seds",
  "version": "1.0.0",
  "description": "The official website for SEDS (sedsngo.org)",
  "private": true,
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "build": "bun run build:css && bun run build:cloudflare",
    "build:css": "tailwindcss -m -i ./app.css -o app/app.css",
    "build:cloudflare": "vite build --mode cloudflare && bun --check",
    "typecheck": "bun --check",
    "test": "bun test",
    "lint": "bun fmt --check && oxlint app src tools test --ignore-path .gitignore --ignore-pattern src/routeTree.gen.ts",
    "lint:fix": "bun fmt",
    "deploy": "PATH=\"$HOME/.local/bin:$PATH\" cf deploy --prebuilt",
    "deploy:verify": "bun tools/deploy-verify.ts",
    "deploy:secrets": "bash tools/upload-secrets.sh",
    "prepare": "husky",
    "secrets:check": "bun tools/check-client-secrets.ts",
    "parity": "bun tools/parity.ts",
    "smoke:preview": "bun tools/smoke-preview.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauricekleine/seds.git"
  },
  "author": "Maurice Kleine <hey@mauricekleine.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mauricekleine/seds/issues"
  },
  "homepage": "https://sedsngo.org",
  "dependencies": {
    "@tailwindcss/typography": "~0.5.20",
    "classnames": "~2.5.1",
    "phosphor-react": "~1.4.1",
    "react": "~19.3.0",
    "react-compare-image": "~3.5.23",
    "react-dom": "~19.3.0",
    "tailwindcss": "~3.4.19",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "~1.168.60"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "~1.62.3",
    "@tailwindcss/forms": "~0.5.11",
    "@types/bun": "~1.4.3",
    "@types/node": "~26.6.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.1",
    "cf": "1.0.0-beta.18",
    "husky": "~9.1.7",
    "oxlint": "1.89.0",
    "pixelmatch": "8.0.0",
    "playwright": "~1.58.2",
    "pngjs": "7.0.0",
    "prettier": "~2.8.8",
    "taze": "21.3.0",
    "typescript": "7.0.2",
    "vite": "~8.3.1"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "24.22.1"
  },
  "packageManager": "bun@1.4.4",
  "type": "module",
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "zod": "4.6.6"
  }
}
